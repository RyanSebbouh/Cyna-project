# ═══════════════════════════════════════════════════
# URL de l'API (Backend Symfony sur AlwaysData)
# ═══════════════════════════════════════════════════
# Je fais pointer le front vers l'adresse api-sbh
VITE_API_URL=https://sbh.alwaysdata.net/api

# ═══════════════════════════════════════════════════
# Environnement de paiement (sandbox ou production)
# ═══════════════════════════════════════════════════
VITE_PAYMENT_ENV=sandbox

# ── STRIPE ──────────────────────────────────────────
VITE_STRIPE_SANDBOX_PUBLIC_KEY=
VITE_STRIPE_LIVE_PUBLIC_KEY=

# ── PAYPAL ──────────────────────────────────────────
VITE_PAYPAL_SANDBOX_CLIENT_ID=
VITE_PAYPAL_LIVE_CLIENT_ID=
